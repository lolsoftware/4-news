/uni-media> </div> </uni-media-carousel-slide> <uni-media-carousel-slide data-theme=\"blue\" shapes=\"[&quot;4-sided-cookie&quot;, &quot;bun&quot;, &quot;square&quot;]\" data-index=\"3\" accordion-header=\"\"> <div slot=\"content\"> <uni-media data-analytics-module=\"{ &quot;module_name&quot;: &quot;Media Carousel/Image&quot;, &quot;section_header&quot;: &quot;Introducing Gemini 3.7 Flash&quot; }\" or-mp4-video-url=\"\" section-header=\"Introducing Gemini 3.7 Flash\" alt-text=\"Quote from LangChain\" video-title=\"\" autoplay=\"true\"> <p><img alt=\"Quote from LangChain\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__la.width-100.format-webp_7qAt1Kr.webp\" loading=\"lazy\" data-loading=\"{ &quot;mobile&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__la.width-500.format-webp_JnZ5w4b.webp&quot;, &quot;desktop&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__l.width-1000.format-webp_Wi4VQ2M.webp&quot; }\"> </p> </uni-media> </div> </uni-media-carousel-slide> <uni-media-carousel-slide data-theme=\"blue\" shapes=\"[&quot;4-sided-cookie&quot;, &quot;bun&quot;, &quot;square&quot;]\" data-index=\"4\" accordion-header=\"\"> <div slot=\"content\"> <uni-media data-analytics-module=\"{ &quot;module_name&quot;: &quot;Media Carousel/Image&quot;, &quot;section_header&quot;: &quot;Introducing Gemini 3.7 Flash&quot; }\" or-mp4-video-url=\"\" section-header=\"Introducing Gemini 3.7 Flash\" alt-text=\"Quote from Nunu.ai\" video-title=\"\" autoplay=\"true\"> <p><img alt=\"Quote from Nunu.ai\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__nu.width-100.format-webp_DyOGCzR.webp\" loading=\"lazy\" data-loading=\"{ &quot;mobile&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__nu.width-500.format-webp_g4YY7w4.webp&quot;, &quot;desktop&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__n.width-1000.format-webp_EdfiOwz.webp&quot; }\"> </p> </uni-media> </div> </uni-media-carousel-slide> <uni-media-carousel-slide data-theme=\"blue\" shapes=\"[&quot;4-sided-cookie&quot;, &quot;bun&quot;, &quot;square&quot;]\" data-index=\"5\" accordion-header=\"\"> <div slot=\"content\"> <uni-media data-analytics-module=\"{ &quot;module_name&quot;: &quot;Media Carousel/Image&quot;, &quot;section_header&quot;: &quot;Introducing Gemini 3.7 Flash&quot; }\" or-mp4-video-url=\"\" section-header=\"Introducing Gemini 3.7 Flash\" alt-text=\"Quote from Open Code\" video-title=\"\" autoplay=\"true\"> <p><img alt=\"Quote from Open Code\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__op.width-100.format-webp_wy8PPtG.webp\" loading=\"lazy\" data-loading=\"{ &quot;mobile&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__op.width-500.format-webp_PXr0X2e.webp&quot;, &quot;desktop&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__o.width-1000.format-webp_WZt9WR2.webp&quot; }\"> </p> </uni-media> </div> </uni-media-carousel-slide> <uni-media-carousel-slide data-theme=\"blue\" shapes=\"[&quot;4-sided-cookie&quot;, &quot;bun&quot;, &quot;square&quot;]\" data-index=\"6\" accordion-header=\"\"> <div slot=\"content\"> <uni-media data-analytics-module=\"{ &quot;module_name&quot;: &quot;Media Carousel/Image&quot;, &quot;section_header&quot;: &quot;Introducing Gemini 3.7 Flash&quot; }\" or-mp4-video-url=\"\" section-header=\"Introducing Gemini 3.7 Flash\" alt-text=\"Quote from Stanford Department of Biology\" video-title=\"\" autoplay=\"true\"> <p><img alt=\"Quote from Stanford Department of Biology\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__st.width-100.format-webp_AzDrTOJ.webp\" loading=\"lazy\" data-loading=\"{ &quot;mobile&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__st.width-500.format-webp_PkLpklf.webp&quot;, &quot;desktop&quot;: &quot;https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__testimonial__s.width-1000.format-webp_hEHwIpV.webp&quot; }\"> </p> </uni-media> </div> </uni-media-carousel-slide> </uni-media-carousel-viewport> </uni-media-carousel>\n</section> <section data-analytics-module=\"{ &quot;module_name&quot;: &quot;Paragraph&quot;, &quot;section_header&quot;: &quot;Introducing Gemini 3.7 Flash&quot; }\"> <uni-article-paragraph> <div><h2 data-block-key=\"vbt12\">Improving Gemini Spark with 3.7 Flash</h2><p data-block-key=\"90mbq\">Gemini Spark, available to Google AI Pro and Ultra subscribers in over <a href=\"https://support.google.com/gemini/answer/17094507?hl=en&amp;co=GENIE.Platform%3DAndroid&amp;sjid=2353166824601345951-NA#:~:text=Available%20wherever%20Gemini%20Apps%20are%20supported%2C%20except%20in%20the%20European%20Economic%20Area%2C%20Nigeria%2C%20Switzerland%2C%20and%20the%20United%20Kingdom\">160 countries</a>, will be using Gemini 3.7 Flash starting today. We launched Spark at I/O as your personal AI agent that runs 24/7, taking action on your behalf while under your direction. This model update makes Spark more efficient for knowledge work with improved tool use for Google Workspace apps, delivering improved accuracy and output quality for complex, multi-skill workflows.</p></div> </uni-article-paragraph>\n</section> <section data-component=\"uni-inline-image\"> <uni-inline-image alignment=\"full\" alt-text=\"MP4 showing how with Gemini 3.7 Flash, Gemini Spark helps turn your ideas into action\" external-image=\"\" or-mp4-video-title=\"spark manufacturing\" or-mp4-video-url=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/original_videos/sparkManufacturing-edit-v3_260812d_NO_AUDIO.mp4\" section-header=\"Introducing Gemini 3.7 Flash\" autoplay=\"true\"> <div slot=\"caption-slot\"> <p data-block-key=\"jbzaz\">With 3.7 Flash, Gemini Spark can turn ideas into action more efficiently by consolidating files, drafting emails, and updating status documents.</p> </div> </uni-inline-image>\n</section> <section data-analytics-module=\"{ &quot;module_name&quot;: &quot;Paragraph&quot;, &quot;section_header&quot;: &quot;Introducing Gemini 3.7 Flash&quot; }\"> <uni-article-paragraph> <div><h2 data-block-key=\"vbt12\">Built with safety in mind</h2><p data-block-key=\"ae21r\">We continually work to improve the coverage and robustness of <a href=\"https://deepmind.google/frontier-safety/\">Frontier Safety safeguards</a>. Gemini 3.7 Flash is shipping with updated safeguards against misuse in the domains of Chemical, Biological, Radiological, and Nuclear (CBRN) and cyber offense, while enabling beneficial use cases, in accordance with <a href=\"https://deepmind.google/blog/our-approach-to-bioresilience/\">our approach to bioresilience</a> and our <a href=\"https://deepmind.google/blog/introducing-gemini-3-5-flash-cyber/\">cyber program</a>.</p><p data-block-key=\"bnksf\">For more information, see the 3.7 Flash <a href=\"https://deepmind.google/models/model-cards/gemini-3-7-flash\">model card</a>.</p><h2 data-block-key=\"8nhsj\">Try it today</h2><ul><li data-block-key=\"7n9tj\"><b>Developers</b>: Explore agent-first workflows in <a href=\"https://antigravity.google/\">Google Antigravity</a> or start building today in the Gemini API via <a href=\"https://ai.dev/prompts/new_chat?model=gemini-3.7-flash\">Google AI Studio</a> and <a href=\"https://developer.android.com/studio\">Android Studio</a>. Get started with our <a href=\"https://ai.google.dev/gemini-api/docs/latest-model\">developer guide</a>.</li><li data-block-key=\"21gi9\"><b>Enterprises</b>: Access 3.7 Flash in <a href=\"https://console.cloud.google.com/agent-platform/publishers/google/model-garden/gemini-3.7-flash\">Gemini Enterprise Agent Platform</a> and the <a href=\"https://cloud.google.com/gemini-enterprise?e=48754805\">Gemini Enterprise</a> app.</li><li data-block-key=\"e7lo3\"><b>Individuals</b>: Available via Spark, your 24/7 personal agent in the Gemini app for Google AI Pro and Ultra subscribers in <a href=\"https://support.google.com/gemini/answer/17094507?hl=en&amp;co=GENIE.Platform%3DAndroid&amp;sjid=2353166824601345951-NA#:~:text=Available%20wherever%20Gemini%20Apps%20are%20supported%2C%20except%20in%20the%20European%20Economic%20Area%2C%20Nigeria%2C%20Switzerland%2C%20and%20the%20United%20Kingdom\">supported countries</a>.</li></ul><h2 data-block-key=\"a45hi\">Detailed benchmarks</h2></div> </uni-article-paragraph>\n</section> <section data-component=\"uni-inline-image\"> <uni-inline-image alignment=\"full\" alt-text=\"a chart displaying AI model benchmarks\" external-image=\"\" or-mp4-video-title=\"\" or-mp4-video-url=\"\" section-header=\"Introducing Gemini 3.7 Flash\" external-link=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchmarks-table__2x.original.png\" autoplay=\"true\"> <p><img alt=\"a chart displaying AI model benchmarks\" src=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchma.width-1200.format-webp.webp\" loading=\"lazy\" sizes=\"(max-width: 768px) 100vw, (max-width: 1024px) 80vw, 1200px\" srcset=\"https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchmar.width-500.format-webp.webp 500w, https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchmar.width-800.format-webp.webp 800w, https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchma.width-1200.format-webp.webp 1200w, https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchma.width-1600.format-webp.webp 1600w, https://storage.googleapis.com/gweb-uniblog-publish-prod/images/gemini-3-7-flash__evals__benchma.width-2000.format-webp.webp 2000w\"> </p> </uni-inline-image>\n</section> <uni-portal portal-id=\"article-newsletter-portal\"> <div data-component=\"uni-article-newsletter\" data-analytics-module=\"{ &quot;module_name&quot;: &quot;Newsletter&quot;, &quot;section_header&quot;: &quot;Get the latest news from Google in your inbox&quot; }\"> <h2> Get the latest news from Google in your inbox </h2> <p> Sign up for our newsletters with product updates, event information, special offers, and more. </p> <p> Your information will be used in accordance with <a href=\"https://policies.google.com/privacy\" target=\"_blank\">Google's privacy policy.</a> You may opt out at any time. </p> </div> </uni-portal> </div> </article></div>",
