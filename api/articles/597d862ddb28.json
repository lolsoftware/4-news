  "content": "<div id=\"readability-page-1\" class=\"page\"><div id=\"main\" data-astro-transition-scope=\"astro-iky5iiiz-1\">  <div> <div> <div>  <p data-reveal=\"true\" data-reveal-eager=\"\">  <h2>\nSimple from zero to scale\n</h2>  </p> </div> <ul data-reveal=\"true\" data-reveal-eager=\"\">  <li>Fast development with robust practices</li> <li>Grows from solo developers to teams of hundreds</li> <li>Scales from single servers to global networks</li> <li>Built on decades of Erlang reliability and fault-tolerance</li>  </ul> </div> <div data-reveal=\"true\" data-reveal-variant=\"right\" data-reveal-eager=\"\">  <astro-island uid=\"Z16Xxkq\" prefix=\"r3\" component-url=\"/_astro/HeroCodeEditor.HIhu8fLN.js\" component-export=\"default\" renderer-url=\"/_astro/client.BfPWZUkF.js\" props=\"{&quot;highlightedExamples&quot;:[1,[[1,[[1,[[0,{&quot;text&quot;:[0,&quot;\\&quot;Fun to learn, delightful to ship\\&quot;&quot;],&quot;color&quot;:[0,&quot;#9ECBFF&quot;]}]]],[1,[[0,{&quot;text&quot;:[0,&quot;|>&quot;],&quot;color&quot;:[0,&quot;#F97583&quot;]}],[0,{&quot;text&quot;:[0,&quot; &quot;],&quot;color&quot;:[0,&quot;#E1E4E8&quot;]}],[0,{&quot;text&quot;:[0,&quot;String&quot;],&quot;color&quot;:[0,&quot;#B392F0&quot;]}],[0,{&quot;text&quot;:[0,&quot;.&quot;],&quot;color&quot;:[0,&quot;#E1E4E8&quot;]}],[0,{&quot;text&quot;:[0,&quot;downcase&quot;],&quot;color&quot;:[0,&quot;#B392F0&quot;]}],[0,{&quot;text&quot;:[0,&quot;()&quot;],&quot;color&quot;:[0,&quot;#E1E4E8&quot;]}]]],[1,[[0,{&quot;text&quot;:[0,&quot;|>&quot;],&quot;color&quot;:[0,&quot;#F97583&quot;]}],[0,{&quot;text&quot;:[0,&quot; &quot;],&quot;color&quot;:[0,&quot;#E1E4E8&quot;]}],[0,{&quot;text&quot;:[0,&quot;String&quot;],&quot;color&quot;:[0,&quot;#B392F0&quot;]}],[0,{&quot;text&quot;:[0,&quot;.&quot;],&quot;color&quot;:[0,&quot;#E1E4E8&quot;]}],[0,{&quot;text&quot;:[0,&quot;replace&quot;],&quot;color&quot;:[0,&quot;#B392F0&quot;]}],[0,{&quot;text&quot;:[0,&quot;(&quot;],&quot;color&quot;:[0,&quot;#E1E4E8&q