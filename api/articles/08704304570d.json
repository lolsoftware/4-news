5.179,1.309-5.516a.97.97,0,0,1,.835-.242,1.15,1.15,0,0,1,.884.46c.621.844.643,2.873.064,6.032l2.263.418c.728-3.973.581-6.386-.477-7.822\" transform=\"translate(-27.322 -0.448)\" fill=\"#000\"></path><path id=\"Path_71\" data-name=\"Path 71\" d=\"M90.594,52.849c-2.394,0-4.7-1.148-5.271-2.758a4.634,4.634,0,0,1,2.07-5.861A5.274,5.274,0,0,1,91.677,44a3.062,3.062,0,0,1,1.728,2.053,3.11,3.11,0,0,1-.425,2.564,5.074,5.074,0,0,1-2,1.637q.221-.018.434-.056c2.341-.422,3.617-2.486,3.689-5.968l2.566.054a9.974,9.974,0,0,1-1.841,6.083,6.407,6.407,0,0,1-4.082,2.388,7.2,7.2,0,0,1-1.152.091M89.9,46.222a3.168,3.168,0,0,0-1.36.311,1.911,1.911,0,0,0-.934,2.12,5.47,5.47,0,0,0,3.237-1.463.536.536,0,0,0,.075-.487.477.477,0,0,0-.305-.354,1.767,1.767,0,0,0-.713-.127\" transform=\"translate(-29.312 -15.05)\" fill=\"#000\"></path><path id=\"Path_72\" data-name=\"Path 72\" d=\"M4.9,2.848c1.092-.827,3.236-.694,6.2.386l.785-2.171C8.047-.334,5.309-.354,3.515,1c-1.61,1.218-2.038,3.219-2.1,5.123H0v2.31H1.483c.009.131.018.26.026.384.033.479.062.892.062,1.2h2.3c0-.39-.031-.84-.067-1.362-.005-.073-.01-.149-.015-.224H11.11V6.127H3.723A4.234,4.234,0,0,1,4.9,2.848\" fill=\"#000\"></path></g></g></svg> </div> <div class=\"fzdz2026post-content\"> <h2>II Forum Zdrowia Dzieci • Przyszłość zaczyna się od zdrowego dziecka</h2> <div>9 grudnia 2026 • Międzynarodowe Centrum Kongresowe w Katowicach</div> </div> <div class=\"fzdz2026post-actions\"> <span class=\"button\">Zarejestruj się</span> </div> </a> </template> </ptwp-banner-after-list> <intext-ads-injector limit=\"auto\" offset=\"60\" viewport-ratio=\"0.6\" no-break=\".read-more-box, h1, h2, h3, h4, h5, h6\" start-after=\"div[data-injected-by-intext], ptwp-random-banner\" stop-at=\"ptwp-post-normalizer\"> <template> <div class=\"sad-container intext_lazy\"> <ptwp-ad-more-info guest-only=\"\"> <div class=\"sad noads has_bounce_all is-unfilled\"> <div class=\"sad-inside\"> <div class=\"sad-content-wrapper\"> <div class=\"sad-content\"> <span class=\"sad-text\">Reklama</span> <ad-gam data-ad-unit=\"intext_lazy\" data-detect-size=\"false\" data-observe-resize=\"false\" data-section=\"content\" data-load=\"wtg\" data-targeting=\"{}\" class=\"has-bounce\"></ad-gam> </div> </div> </div> </div> </ptwp-ad-more-info> </div> </template>\n\t</intext-ads-injector> <ul>\n<li>Zdaniem gen. Grzegorza Gieleraka co najmniej połowa z 800 polskich placówek szpitalnych mogłaby nie sprostać poważnemu kryzysowi</li>\n<li>W razie wojny szpitale na wschodzie mają stabilizować rannych, a w ciągu maksymalnie 3-5 dni przekazywać ich do placówek na zachodzie kraju na dalsze leczenie</li>\n<li>Przygotowywana sieć bezpieczeństwa medycznego obejmie ok. 80 placówek i ma być gotowa do końca 2029 r.</li>\n<li>W wybranych szpitalach przybędzie łóżek intensywnej terapii; ma się też poprawić dostęp do bloków operacyjnych</li>\n<li>Ekspert ocenił także, że pierwszeństwo w dostępie do świadczeń dla rodzin żołnierzy w szpitalach nadzorowanych przez MON, przewidziane w Karcie Rodzin Mundurowych, nie powinno znacząco wydłużyć kolejek</li>\n</ul>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Finanse-i-zarzadzanie/Tak-zarabiaja-polscy-lekarze-na-tle-Europy-Trzy-specjalizacje-sa-najlepiej-oplacane,291746,1.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/09/81/250981_r0_300.jpg\" alt=\"Tak zarabiają polscy lekarze na tle Europy. Trzy specjalizacje są najlepiej opłacane\" title=\"Jak Polska wypada pod kątem dostępności i rozmieszczenia kadry lekarskiej na tle Europy?\" width=\"300\" height=\"200\"> </a> </p> </div>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Prawo/Senat-zdecydowal-w-sprawie-refundacji-lekow-Farmaceuci-nie-zobacza-diagnozy-na-recepcie,291754,2.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/10/12/251012_r0_300.jpg\" alt=\"Senat zdecydował w sprawie refundacji leków. Farmaceuci nie zobaczą diagnozy na recepcie\" title=\"Farmaceuci nie zobaczą diagnozy na recepcie\" width=\"300\" height=\"200\"> </a> </p> </div>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Finanse-i-zarzadzanie/Dawid-K-z-nowymi-zarzutami-Uslyszal-je-od-Rzecznika-Odpowiedzialnosci-Zawodowej,291727,1.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/09/83/250983_r0_300.jpg\" alt=\"Dawid K. z nowymi zarzutami. Usłyszał je od Rzecznika Odpowiedzialności Zawodowej\" title=\"Dawid K. z kolejnymi zarzutami. Tym razem od rzecznika odpowiedzialności zawodowej\" width=\"300\" height=\"200\"> </a> </p> </div>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Finanse-i-zarzadzanie/Kolejny-cyberatak-na-dane-pacjentow-System-dla-lekarzy-zostal-wylaczony,291747,1.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/09/97/250997_r0_300.jpg\" alt=\"Kolejny cyberatak na dane pacjentów. System dla lekarzy został wyłączony\" title=\"Hakerzy zaatakowali systemy gabinetowe praktyk lekarskich\" width=\"300\" height=\"200\"> </a> </p> </div>\n\n<h2>Przy najmniejszym kryzysie część szpitali \"pęknie\". Specjalną sieć utworzy ok. 80 z nich</h2>\n<p>Co najmniej połowa z około 800 polskich placówek szpitalnych nie sprostałaby, zdaniem <strong>gen. broni prof. n. med. Grzegorza Gieleraka</strong>, poważnemu kryzysowi. W czwartek, 26 listopada na antenie radia RMF FM dyrektor Wojskowego Instytutu Medycznego - Państwowego Instytutu Badawczego mówił o planie budowy sieci bezpieczeństwa medycznego. Miałaby ona objąć <strong>około 80 placówek</strong> i być gotowa do <strong>końca 2029 r.</strong></p>\n<p>Gen. Gielerak odwołał się przy tym do analizy danych Narodowego Funduszu Zdrowia dotyczących 140 placówek w czterech wschodnich województwach. Jak mówił, jedynie połowa z nich spełnia kryteria kwalifikacji do wspomnianej sieci. Pod uwagę wzięto w sumie <strong>27 wskaźników</strong>, m.in. dostęp do chirurgii, ortopedii, intensywnej terapii czy banku krwi, a także tzw. TIS-y oceniające liczbę i poziom skomplikowania leczonych przypadków.</p>\n<blockquote>\n<p>- Co najmniej połowa spośród ok. 800 podmiotów, które mamy, nie byłaby w stanie stawić czoła kryzysowi. (...) Można powiedzieć, że one świetnie mogą sprawdzać się w warunkach pokojowych, ale przy najmniejszym kryzysie, przy zagrożeniu degradacją, niestety pękną - mówił ekspert.</p>\n</blockquote>\n<p>Polska, w odróżnieniu od zachodnich koncepcji, w trakcie kryzysu ma postawić na zwiększenie liczby miejsc w szpitalach, a nie tylko na przesuwanie pacjentów planowych, aby zrobić miejsce dla rannych. Zdaniem generała doświadczenie pandemii pokazało, że „system załamał się, głównie z tego powodu, że osoby niechorujące na COVID, ale na wszystkie inne choroby, które w czasie wojny również będą miały miejsce, nie były w stanie uzyskać pomocy medycznej”.</p>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Polska-i-swiat/Po-zamachu-w-Krakowie-177-osob-z-odznakami-Za-Zaslugi-dla-Ochrony-Zdrowia,291686,15.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/09/25/250925_r0_300.jpg\" alt=\"Po zamachu w Krakowie: 177 osób z odznakami „Za Zasługi dla Ochrony Zdrowia”\" title=\"Ministra Jolanta Sobierańska-Grenda podczas uroczystości wręczenia odznak honorowych „Za zasługi dla ochrony zdrowia”\" width=\"300\" height=\"200\"> </a> </p> </div>\n\n<h2>Stabilizacja rannych na wschodzie, dalsze leczenie na zachodzie</h2>\n<p>Dopytywany, co zatem zrobić, aby system w czasie kryzysu się nie załamał, tłumaczył, że w wybranych szpitalach powinno przybyć łóżek intensywnej terapii, a bloki operacyjne i diagnostyka powinny być łatwiej dostępne.</p>\n<p>W razie wojny placówki na wschodzie miałyby stabilizować rannych, a szpitale na zachodzie przejmować ich dalsze leczenie.</p>\n<blockquote>\n<p>- Celem systemu na wschodzie będzie szybka stabilizacja rannego i w ciągu maks. 3 do 5 dni ewakuacja strategiczna na ścianę zachodnią i tam dopiero tzw. leczenie definitywne, czyli operacje rekonstrukcyjne, przywracanie zdrowia w każdej formie, włącznie z np. pomocą psychologiczną, psychiatryczną - tłumaczył generał.</p>\n</blockquote>\n<p>Jak mówił, przeanalizowano także, ilu specjalistów będzie potrzebnych do stabilizowania rannych. To <strong>ok. 5 tys. osób</strong> oraz kilkuset specjalistów z zakresu chirurgii, neurochirurgii i chirurgii naczyniowej. Kluczowe będzie jednak ich odpowiednie przeszkolenie w najbliższych latach.</p>\n<p>Przyznał także, że z perspektywy wojskowych planistów Polska powinna była wcześniej rozpocząć przygotowania do budowy systemu bezpieczeństwa medycznego. - Jak analizujemy, to powiem: brakuje mi dwóch lat - zaznaczył.</p>\n<p>Zapewnił jednak, że prace przebiegają w przyspieszonym tempie, a doświadczenia i rozwiązania już wypracowane mogą pozwolić skrócić harmonogram. - Docelowo sieć bezpieczeństwa medycznego ma zostać przygotowana do końca 2029 roku - podkreślił ekspert.</p>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Polityka-zdrowotna/Prof-Gielerak-warunkiem-odpornosci-na-kryzys-jest-zapas-lekow-krytycznych,283553,14.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/24/11/87/241187_r0_300.jpg\" alt=\"Prof. Gielerak: warunkiem odporności na kryzys jest zapas leków krytycznych\" title=\"Grzegorz Gielerak podczas EEC 2026\" width=\"300\" height=\"200\"> </a> </p> </div>\n\n<h2>Pierwszeństwo dla rodzin mundurowych. „Dajmy sobie szansę”</h2>\n<p>Z ostrożnym optymizmem gen. Gielerak odniósł się natomiast do projektu <strong>Karty Rodzin Mundurowych</strong>. Zakłada ona, przypomnijmy, m.in. dostęp do świadczeń medycznych poza kolejnością w placówkach podległych MON i MSWiA dla rodzin mundurowych. Zdaniem generała rozwiązanie to nie powinno znacząco wydłużyć kolejek dla pozostałych pacjentów.</p>\n<blockquote>\n<p>- Karta dotyczy wyłącznie trzynastu szpitali nadzorowanych przez ministra obrony narodowej. Z punktu widzenia całego systemu nie powinno to w istotny sposób wpłynąć na dostępność świadczeń - tłumaczył ekspert.</p>\n</blockquote>\n<p>Zaznaczył przy tym, że już dzisiaj w kierowanym przez niego Instytucie aż <strong>95 proc.</strong> pacjentów to osoby cywilne. - W związku z tym nic się nie zmieni. Dajmy sobie szansę i zobaczmy, jak to rozwiązanie sprawdzi się w praktyce - dodał.</p>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Finanse-i-zarzadzanie/Lapowki-podrobione-leki-i-prezenty-od-koncernow-Naukowcy-korupcje-w-ochronie-zdrowia-napedza-system,291767,1.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/10/19/251019_r0_300.jpg\" alt=\"Łapówki, podrobione leki i prezenty od koncernów. Naukowcy: korupcję w ochronie zdrowia napędza system\" title=\"Naukowcy przyjrzeli się korupcji w medycynie\" width=\"300\" height=\"200\"> </a> </p> </div>\n<div> <p><a href=\"https://www.rynekzdrowia.pl/Polska-i-swiat/Polacy-zle-oceniaja-ochrone-zdrowia-Coraz-czesciej-szukaja-pomocy-poza-systemem,291755,15.html\"> <img loading=\"lazy\" src=\"https://pliki.rynekzdrowia.pl/i/25/10/05/251005_r0_300.jpg\" alt=\"Polacy źle oceniają ochronę zdrowia. Coraz częściej szukają pomocy poza systemem\" title=\"Podczas prezentacji STADA Health Report 2026 eksperci omówili najważniejsze wyzwania polskiego systemu ochrony zdrowia.\" width=\"300\" height=\"200\"> </a> </p> </div> <ptwp-post-normalizer></ptwp-post-normalizer> <p> <img loading=\"lazy\" src=\"https://i.rynekzdrowia.pl/images/v2021/copyright.svg\" alt=\"\" width=\"23\" height=\"23\"> Materiał chroniony prawem autorskim - zasady przedruków określa <strong><a href=\"https://www.rynekzdrowia.pl/Info/regulamin.html\">regulamin</a></strong>. </p> <div> <p> Dowiedz się więcej na temat: </p> </div> </div></div>",
