  "content": "<div id=\"readability-page-1\" class=\"page\"><div> <p>From Wikipedia, the free encyclopedia</p> </div><div lang=\"en\" dir=\"ltr\" data-mw-parsoid-version=\"0.24.0.0-alpha18\" data-mw-html-version=\"2.8.0\" id=\"mw-content-text\"><section data-mw-section-id=\"0\" id=\"mwAQ\"><span about=\"#mwt1\"></span>\n<span about=\"#mwt2\" typeof=\"mw:Transclusion\" id=\"mwAw\" data-mw=\"{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Infobox book\\n&quot;,&quot;href&quot;:&quot;./Template:Infobox_book&quot;},&quot;params&quot;:{&quot;name&quot;:{&quot;wt&quot;:&quot;Bufo Alvarius: the Psychedelic Toad of the Sonoran Desert&quot;},&quot;image&quot;:{&quot;wt&quot;:&quot;Bufo Alvarius, The Psychedelic Toad of the Sonora Desert cover.jpeg&quot;},&quot;image_size&quot;:{&quot;wt&quot;:&quot;150px&quot;},&quot;border&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;alt&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;caption&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;author&quot;:{&quot;wt&quot;:&quot;Albert Most (Ken Nelson)&quot;},&quot;audio_read_by&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;title_orig&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;orig_lang_code&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;title_working&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;translator&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;illustrator&quot;:{&quot;wt&quot;:&quot;Gail Patterson&quot;},&quot;cover_artist&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;country&quot;:{&quot;wt&quot;:&quot;[[Denton, Texas]], [[United States]]&quot;},&quot;language&quot;:{&quot;wt&quot;:&quot;English&quot;},&quot;series&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;release_number&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;subject&quot;:{&quot;wt&quot;:&quot;[[Sonoran Desert toad]]; [[5-MeO-DMT]]; [[Psychedelic drug]]s&quot;},&quot;genre&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;set_in&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;publisher&quot;:{&quot;wt&quot;:&quot;Venom Press&quot;},&quot;publisher2&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;pub_date&quot;:{&quot;wt&quot;:&quot;1984&quot;},&quot;english_pub_date&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;published&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;media_type&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;pages&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;awards&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;isbn&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;isbn_note&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;oclc&quot;:{&quot;wt&quot;:&quot;79477238&quot;},&quot;dewey&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;congress&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;native_wikisource&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;wikisource&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;notes&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;exclude_cover&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;website&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;module&quot;:{&quot;wt&quot;:&quot;&quot;}},&quot;i&quot;:0}}]}\"></span><table about=\"#mwt2\" id=\"mwBA\"><caption>Bufo Alvarius: the Psychedelic Toad of the Sonoran Desert <span title=\"ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Bufo+Alvarius%3A+the+Psychedelic+Toad+of+the+Sonoran+Desert&amp;rft.author=Albert+Most+%28Ken+Nelson%29&amp;rft.date=1984&amp;rft.pub=Venom+Press&amp;rft.place=%5B%5BDenton%2C+Texas%5D%5D%2C+%5B%5BUnited+States%5D%5D&amp;rft_id=info:oclcnum/79477238\"></span></caption><tbody><tr><td colspan=\"2\"><span typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Bufo_Alvarius,_The_Psychedelic_Toad_of_the_Sonora_Desert_cover.jpeg\"><img resource=\"https://en.wikipedia.org/wiki/File:Bufo_Alvarius,_The_Psychedelic_Toad_of_the_Sonora_Desert_cover.jpeg\" src=\"https://upload.wikimedia.org/wikipedia/en/thumb/a/a1/Bufo_Alvarius%2C_The_Psychedelic_Toad_of_the_Sonora_Desert_cover.jpeg/250px-Bufo_Alvarius%2C_The_Psychedelic_Toad_of_the_Sonora_Desert_cover.jpeg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" data-file-width=\"258\" data-file-height=\"387\" data-file-type=\"bitmap\" height=\"225\" width=\"150\" srcset=\"https://upload.wikimedia.org/wikipedia/en/a/a1/Bufo_Alvarius%2C_The_Psychedelic_Toad_of_the_Sonora_Desert_cover.jpeg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\"></a></span></td></tr><tr><th scope=\"row\">Author</th><td>Albert Most (Ken Nelson)</td></tr><tr><th scope=\"row\">Illustrator</th><td>Gail Patterson</td></tr><tr><th scope=\"row\">Language</th><td>English</td></tr><tr><th scope=\"row\">Subject</th><td><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sonoran_Desert_toad\" title=\"Sonoran Desert toad\">Sonoran Desert toad</a>; <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/5-MeO-DMT\" title=\"5-MeO-DMT\">5-MeO-DMT</a>; <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Psychedelic_drug\" title=\"Psychedelic drug\">Psychedelic drugs</a></td></tr><tr><th scope=\"row\">Publisher</th><td>Venom Press</td></tr><tr><th scope=\"row\">Publication<span typeof=\"mw:Entity\">&nbsp;</span>date</th><td>1984</td></tr><tr><th scope=\"row\">Publication<span typeof=\"mw:Entity\">&nbsp;</span>place</th><td><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Denton,_Texas\" title=\"Denton, Texas\">Denton, Texas</a>, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States\" title=\"United States\">United States</a></td></tr><tr><th scope=\"row\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/OCLC_(identifier)\" title=\"OCLC (identifier)\"><abbr title=\"Online Computer Library Center number\" about=\"#mwt5\" typeof=\"mw:ExpandedAttrs\" data-mw=\"{&quot;attribs&quot;:[[{&quot;txt&quot;:&quot;title&quot;},{&quot;html&quot;:&quot;<span typeof=\\&quot;mw:Nowiki\\&quot; id=\\&quot;mwBQ\\&quot;>Online Computer Library Center number</span>&quot;}]]}\">OCLC</abbr></a></th><td><a rel=\"mw:ExtLink nofollow\" href=\"https://www.worldcat.org/oclc/79477238\">79477238</a></td></tr></tbody></table>\n\n<p id=\"mwBg\"><i id=\"mwBw\"><b id=\"mwCA\">Bufo Alvarius: the Psychedelic Toad of the Sonoran Desert</b></i> is an underground <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Pamphlet\" title=\"Pamphlet\" id=\"mwCQ\">pamphlet</a> written by Albert Most (real name Ken Nelson (1954–2019)), illustrated by Gail Patterson, and published by Venom Press in 1984.<sup about=\"#mwt8\" id=\"cite_ref-Villa2023_1-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Villa2023-1&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwCg\"><span id=\"mwCw\"><span id=\"mwDA\">[</span>1<span id=\"mwDQ\">]</span></span></a></sup><sup about=\"#mwt9\" id=\"cite_ref-WeilDavis1994_2-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;WeilDavis1994&quot;}}\"><a href=\"#cite_note-WeilDavis1994-2\" id=\"mwDg\"><span id=\"mwDw\"><span id=\"mwEA\">[</span>2<span id=\"mwEQ\">]</span></span></a></sup> It described how to extract the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Venom\" title=\"Venom\" id=\"mwEg\">venom</a> of the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sonoran_Desert_toad\" title=\"Sonoran Desert toad\" id=\"mwEw\">Sonoran Desert toad</a> (formerly <i id=\"mwFA\">Bufo alvarius</i>, now <i id=\"mwFQ\">Incilius alvarius</i>), which contains the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Serotonergic_psychedelic\" title=\"Serotonergic psychedelic\" id=\"mwFg\">serotonergic psychedelic</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/5-MeO-DMT\" title=\"5-MeO-DMT\" id=\"mwFw\">5-MeO-DMT</a>, and administer the venom to produce <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Hallucinogen\" title=\"Hallucinogen\" id=\"mwGA\">hallucinogenic</a> effects.<sup about=\"#mwt10\" id=\"cite_ref-Villa2023_1-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwGQ\"><span id=\"mwGg\"><span id=\"mwGw\">[</span>1<span id=\"mwHA\">]</span></span></a></sup> The pamphlet was responsible for the start of the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Recreational_drug\" title=\"Recreational drug\" id=\"mwHQ\">recreational use</a> of the toad venom and of 5-MeO-DMT.<sup about=\"#mwt11\" id=\"cite_ref-Villa2023_1-2\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwHg\"><span id=\"mwHw\"><span id=\"mwIA\">[</span>1<span id=\"mwIQ\">]</span></span></a></sup><sup about=\"#mwt14\" id=\"cite_ref-Siebert2021_3-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Siebert2021&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Siebert2021-3&quot;}}\"><a href=\"#cite_note-Siebert2021-3\" id=\"mwIg\"><span id=\"mwIw\"><span id=\"mwJA\">[</span>3<span id=\"mwJQ\">]</span></span></a></sup><sup about=\"#mwt17\" id=\"cite_ref-WeilDavis1994_2-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;WeilDavis1994&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-WeilDavis1994-2&quot;}}\"><a href=\"#cite_note-WeilDavis1994-2\" id=\"mwJg\"><span id=\"mwJw\"><span id=\"mwKA\">[</span>2<span id=\"mwKQ\">]</span></span></a></sup><sup about=\"#mwt20\" id=\"cite_ref-ErmakovaDunbarRucker2022_4-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;ErmakovaDunbarRucker2022&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-ErmakovaDunbarRucker2022-4&quot;}}\"><a href=\"#cite_note-ErmakovaDunbarRucker2022-4\" id=\"mwKg\"><span id=\"mwKw\"><span id=\"mwLA\">[</span>4<span id=\"mwLQ\">]</span></span></a></sup> Subsequently, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Andrew_Weil\" title=\"Andrew Weil\" id=\"mwLg\">Andrew Weil</a> and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Wade_Davis_(anthropologist)\" title=\"Wade Davis (anthropologist)\" id=\"mwLw\">Wade Davis</a>, in part citing the pamphlet, described the psychoactive effects of the toad in the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Scientific_literature\" title=\"Scientific literature\" id=\"mwMA\">scientific literature</a> in 1992.<sup about=\"#mwt21\" id=\"cite_ref-WeilDavis1994_2-2\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;WeilDavis1994&quot;}}\"><a href=\"#cite_note-WeilDavis1994-2\" id=\"mwMQ\"><span id=\"mwMg\"><span id=\"mwMw\">[</span>2<span id=\"mwNA\">]</span></span></a></sup><sup about=\"#mwt24\" id=\"cite_ref-DavisWeil1992_5-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;DavisWeil1992&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-DavisWeil1992-5&quot;}}\"><a href=\"#cite_note-DavisWeil1992-5\" id=\"mwNQ\"><span id=\"mwNg\"><span id=\"mwNw\">[</span>5<span id=\"mwOA\">]</span></span></a></sup> In addition, they described the finding as the first instance of a psychedelic from an animal source to be discovered.<sup about=\"#mwt25\" id=\"cite_ref-WeilDavis1994_2-3\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;WeilDavis1994&quot;}}\"><a href=\"#cite_note-WeilDavis1994-2\" id=\"mwOQ\"><span id=\"mwOg\"><span id=\"mwOw\">[</span>2<span id=\"mwPA\">]</span></span></a></sup> Following the publication of the pamphlet, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Recreational_drug\" title=\"Recreational drug\" id=\"mwPQ\">recreational use</a> of the toads was encountered by the late 1980s and became a media sensation.<sup about=\"#mwt28\" id=\"cite_ref-Lyttle1993_6-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Lyttle1993&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Lyttle1993-6&quot;}}\"><a href=\"#cite_note-Lyttle1993-6\" id=\"mwPg\"><span id=\"mwPw\"><span id=\"mwQA\">[</span>6<span id=\"mwQQ\">]</span></span></a></sup></p>\n\n<p id=\"mwQg\">The pamphlet was originally published pseudonymously.<sup about=\"#mwt29\" id=\"cite_ref-Villa2023_1-3\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwQw\"><span id=\"mwRA\"><span id=\"mwRQ\">[</span>1<span id=\"mwRg\">]</span></span></a></sup><sup about=\"#mwt32\" id=\"cite_ref-Rodrigue2021_7-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Rodrigue2021&quot;},&quot;body&quot;:{&quot;id&quot;:&quot;mw-reference-text-cite_note-Rodrigue2021-7&quot;}}\"><a href=\"#cite_note-Rodrigue2021-7\" id=\"mwRw\"><span id=\"mwSA\"><span id=\"mwSQ\">[</span>7<span id=\"mwSg\">]</span></span></a></sup> Journalist <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Hamilton_Morris\" title=\"Hamilton Morris\" id=\"mwSw\">Hamilton Morris</a> described becoming obsessed with identifying the author of the pamphlet.<sup about=\"#mwt33\" id=\"cite_ref-Rodrigue2021_7-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Rodrigue2021&quot;}}\"><a href=\"#cite_note-Rodrigue2021-7\" id=\"mwTA\"><span id=\"mwTQ\"><span id=\"mwTg\">[</span>7<span id=\"mwTw\">]</span></span></a></sup> Morris came upon a man named Alfred Savinelli, who claimed to be the author, and published this in his documentary series <i id=\"mwUA\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Hamilton's_Pharmacopeia\" title=\"Hamilton's Pharmacopeia\" id=\"mwUQ\">Hamilton's Pharmacopeia</a></i> in 2017.<sup about=\"#mwt34\" id=\"cite_ref-Villa2023_1-4\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwUg\"><span id=\"mwUw\"><span id=\"mwVA\">[</span>1<span id=\"mwVQ\">]</span></span></a></sup> Savinelli as the author, however, ultimately proved to be incorrect.<sup about=\"#mwt35\" id=\"cite_ref-Villa2023_1-5\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwVg\"><span id=\"mwVw\"><span id=\"mwWA\">[</span>1<span id=\"mwWQ\">]</span></span></a></sup> The real author, Ken Nelson, subsequently contacted Morris and proved his identity.<sup about=\"#mwt36\" id=\"cite_ref-Villa2023_1-6\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwWg\"><span id=\"mwWw\"><span id=\"mwXA\">[</span>1<span id=\"mwXQ\">]</span></span></a></sup> In 2020, a new episode of <i id=\"mwXg\">Hamilton's Pharmacopeia</i> revealed Nelson as the true author, and Morris apologized for the mistake.<sup about=\"#mwt37\" id=\"cite_ref-Rodrigue2021_7-2\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Rodrigue2021&quot;}}\"><a href=\"#cite_note-Rodrigue2021-7\" id=\"mwXw\"><span id=\"mwYA\"><span id=\"mwYQ\">[</span>7<span id=\"mwYg\">]</span></span></a></sup> Nelson died due to <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Parkinson's_disease\" title=\"Parkinson's disease\" id=\"mwYw\">Parkinson's disease</a> in 2019 prior to the airing.<sup about=\"#mwt38\" id=\"cite_ref-Rodrigue2021_7-3\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Rodrigue2021&quot;}}\"><a href=\"#cite_note-Rodrigue2021-7\" id=\"mwZA\"><span id=\"mwZQ\"><span id=\"mwZg\">[</span>7<span id=\"mwZw\">]</span></span></a></sup> In 2021, with Nelson's permission, Morris (and two producers: Justin Clark and Soren Shade) published a revised and expanded edition of the pamphlet that included a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Chemical_synthesis\" title=\"Chemical synthesis\" id=\"mwaA\">chemical synthesis</a> for 5-MeO-DMT.<sup about=\"#mwt39\" id=\"cite_ref-Villa2023_1-7\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwaQ\"><span id=\"mwag\"><span id=\"mwaw\">[</span>1<span id=\"mwbA\">]</span></span></a></sup> The inclusion of the synthesis of 5-MeO-DMT was prompted by concerns about endangerment and reduction of the toad population.<sup about=\"#mwt40\" id=\"cite_ref-Villa2023_1-8\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw=\"{&quot;name&quot;:&quot;ref&quot;,&quot;attrs&quot;:{&quot;name&quot;:&quot;Villa2023&quot;}}\"><a href=\"#cite_note-Villa2023-1\" id=\"mwbQ\"><span id=\"mwbg\"><span id=\"mwbw\">[</span>1<span id=\"mwcA\">]</span></span></a></sup></p>\n\n</section><section data-mw-section-id=\"1\" id=\"mwcQ\" aria-labelledby=\"See_also\">\n<ul id=\"mwcg\"><li id=\"mwcw\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_psychedelic_literature\" title=\"List of psychedelic literature\" id=\"mwdA\">List of psychedelic literature</a></li>\n<li id=\"mwdQ\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Psychedelic_drug#History\" title=\"Psychedelic drug\" id=\"mwdg\">Psychedelic drug § History</a></li>\n<li id=\"mwdw\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Seeking_the_Magic_Mushroom\" title=\"Seeking the Magic Mushroom\" id=\"mweA\">Seeking the Magic Mushroom</a> (1957)</li></ul>\n\n</section><section data-mw-section-id=\"2\" id=\"mweQ\" aria-labelledby=\"References\">\n<span about=\"#mwt41\" typeof=\"mw:Transclusion\" id=\"mweg\" data-mw=\"{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Reflist&quot;,&quot;href&quot;:&quot;./Template:Reflist&quot;},&quot;params&quot;:{},&quot;i&quot;:0}}]}\"></span><div typeof=\"mw:Extension/references\" about=\"#mwt41\" id=\"mwew\" data-mw=\"{&quot;name&quot;:&quot;references&quot;,&quot;attrs&quot;:{&quot;group&quot;:&quot;&quot;,&quot;responsive&quot;:&quot;1&quot;},&quot;body&quot;:{&quot;extsrc&quot;:&quot;&quot;}}\"><ol id=\"mwfQ\"><li about=\"#cite_note-Villa2023-1\" id=\"cite_note-Villa2023-1\" data-mw-footnote-number=\"1\"><span rel=\"mw:referencedBy\" id=\"mwfg\"><a href=\"#cite_ref-Villa2023_1-0\" id=\"mwfw\"><span id=\"mwgA\">1</span></a> <a href=\"#cite_ref-Villa2023_1-1\" id=\"mwgQ\"><span id=\"mwgg\">2</span></a> <a href=\"#cite_ref-Villa2023_1-2\" id=\"mwgw\"><span id=\"mwhA\">3</span></a> <a href=\"#cite_ref-Villa2023_1-3\" id=\"mwhQ\"><span id=\"mwhg\">4</span></a> <a href=\"#cite_ref-Villa2023_1-4\" id=\"mwhw\"><span id=\"mwiA\">5</span></a> <a href=\"#cite_ref-Villa2023_1-5\" id=\"mwiQ\"><span id=\"mwig\">6</span></a> <a href=\"#cite_ref-Villa2023_1-6\" id=\"mwiw\"><span id=\"mwjA\">7</