  "content": "<div id=\"readability-page-1\" class=\"page\"><div id=\"GemiusXYMap:size_Big\"><div data-ds-theme=\"news\" data-ds-theme-path=\"article.nav.default\"></div><div></div></div></dialog></yennefer-island><template id=\"account-logged-in-template\"></template><template id=\"account-logged-out-template\"><div class=\"sc-hvkINvy sc-BGXOWy ZnxMBy bzXYxCy NavigationItem NavigationItem--topNavigation\" part=\"NavigationItem NavigationItem--topNavigation\"><span class=\"sc-aXZVgy sc-gEvEery ldavXXy dUmtgUy sc-daNmkLy krsiuky TextBox\" part=\"TextBox\" id=\"account-link-login\" tabindex=\"0\"><span class=\"sc-j74mbv-1 ijPOvxy\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" class=\"sc-SrznAy hBUUaGy sc-j74mbv-0 kllSWqy MonoIcon SignIn_svg__ut-sign-in\" viewBox=\"0 0 20 20\" width=\"1em\" height=\"1em\" role=\"img\"><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M4 5.882c0 3.25 2.68 5.883 5.988 5.883 3.307 0 5.988-2.634 5.988-5.883S13.295 0 9.988 0 4 2.633 4 5.882m10.414 0c0 2.404-1.98 4.348-4.426 4.348S5.562 8.286 5.562 5.882s1.979-4.348 4.426-4.348 4.426 1.945 4.426 4.348M.768 20a.7.7 0 0 1-.374-.102.78.78 0 0 1-.3-1.049c2.021-3.632 5.814-5.908 9.906-5.908 4.09 0 7.884 2.276 9.905 5.908.2.384.074.843-.275 1.049a.75.75 0 0 1-1.023-.282c-1.772-3.17-5.064-5.14-8.607-5.14-3.544 0-6.836 1.97-8.583 5.14-.124.256-.4.384-.649.384\" clip-rule=\"evenodd\"></path></svg><span class=\"_loginText_fjcsq_28\">Zaloguj się</span></span></span></div></template></div></div></yennefer-island></div><div><div><main><div></div><strong part=\"Lead TextBox\" data-lead=\"\">W jednym z mieszkań w Zamościu (Lubelskie) znaleziono ciała dwóch osób. Policja pod nadzorem prokuratury wyjaśnia okoliczności ich śmierci. </strong><p part=\"Paragraph TextBox\" data-paragraph=\"\">W sobotę strażacy i policjanci zostali wezwani do otwarcia mieszkania przy ulicy generała Bema w Zamościa, po tym jak sąsiedzi zgłosili nieprzyjemny zapach wydostający się z wnętrza. </p><p part=\"Paragraph TextBox\" data-paragraph=\"\">W mieszkaniu znaleźli zwłoki dwóch osób. </p><div part=\"NewsInlineTeaser\" data-detal-teaser=\"\" data-teaser-id=\"9098742\" data-teaser-title=\"DOWIEDZ SIĘ WIĘCEJ:\" data-category=\"storyline-teaser-module\" data-position=\"1\" data-type=\"layout\" data-teasers-start=\".dashboard-storyline-teaser\" data-teaser-ids=\"9098742\" data-storyline-module=\"\"></div><p part=\"Paragraph TextBox\" data-paragraph=\"\">Nie jest znany wiek zmarłych, ani ich tożsamość.</p><p part=\"Paragraph TextBox\" data-paragraph=\"\">Policjanci pod nadzorem prokuratury wyjaśnia okoliczności tej tragedii. </p></main></div><div part=\"AuthorsModule AuthorsModule--horizontal Author--vertical\" data-category=\"author_module\" data-position=\"2\" data-type=\"widget\" data-teasers-start=\".sc-fBdRDiy\" data-teaser-ids=\"9106116,9105521,9105411\" data-name=\"NAJNOWSZE MATERIAŁY AUTORA\" data-module=\"\"><p>NAJNOWSZE MATERIAŁY AUTORA</p></div></div><template data-template=\"ERROR_BOARD\"><div class=\"sc-cCAuRXy sc-gYstsuy cKIhnLy jHsovRy sc-134dw4h-0 dvjxtPy NuviBoard\" part=\"NuviBoard\"><div class=\"sc-jgtTJdy foSWooy\"><h1 class=\"sc-aXZVgy sc-gEvEery ldavXXy dUmtgUy sc-eyvILCy sc-gfoqjTy ikDiMZy gEdWdoy NuviBoard-title Title TextBox\" part=\"Title TextBox\"></h1><p class=\"sc-aXZVgy sc-gEvEery ldavXXy dUmtgUy sc-cmQiKEy bpbHbjy NuviBoard-description TextBox\" part=\"TextBox\"></p><p class=\"sc-aXZVgy sc-gEvEery ldavXXy dUmtgUy sc-iRqkffy gdtKODy NuviBoard-support TextBox\" part=\"TextBox\"><a class=\"sc-bXMzgGy cbZsYJy NuviBoard-link\" href=\"\"></a></p></div></div></template><template data-template=\"ERROR_BOARD-audio\"><div data-audio-error-link-href=\"\" data-audio-error-link-text=\"\" data-audio-error-title=\"\"></div></template>\n<!--ESI-SLOT-START(varnish:/_i/y/f/esi/demo)-->\n<!--ESI Generated: Sat, 20 Jun 2026 17:50:42 GMT -->\n<!--ESI-SLOT-END-->\n</div></div>",
